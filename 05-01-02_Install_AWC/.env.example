# .env.example — template for install_awc_console.sh
#
# Copy this file to `.env` (in the same directory as the script) and
# fill in your values. The script sources .env automatically before
# checking required variables.
#
#   cp .env.example .env
#   chmod 600 .env
#   $EDITOR .env
#
# Never commit .env to git — it contains credentials.

# Your student number (default 33 if unset).
STUDENT_NUMBER=33

# --- Taikun / CCF ------------------------------------------------------
# From your CCF project's Project Properties page:
TAIKUN_PROJECT_ID=

# The Robot User keys generated in 04-01-02:
TAIKUN_ACCESS_KEY=
TAIKUN_SECRET_KEY=

# --- Cloudera paywall --------------------------------------------------
# Credentials for container.repository.cloudera.com and
# docker-private.infra.cloudera.com. Provided by the training team.
PAYWALL_USERNAME=
PAYWALL_PASSWORD=

# --- AWS (Route 53 via external-dns) -----------------------------------
# Access keys for the awc_student{N} IAM user created in 03-02-03.
# This user must have the awc-student{N}-route53 policy attached.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AWC Console first-login password ---------------------------------
# Pick a strong password. This is what you type at first login to the
# console at https://console.student{N}.awcqe2.sandbox21.cloudera.com/
ADMIN_PASSWORD=

# --- Optional overrides -----------------------------------------------
# Uncomment to override the defaults baked into the script.
#TAIKUN_API_HOST=api.ccf-preprod.internal.cloudera.com
#TAIKUN_ACCOUNT_NAME=cloudera
#TAIKUN_ORGANIZATION_ID=109
#MARKETPLACE_REGISTRIES=docker-private.repository.cloudera.com/cloudera/awc-marketplace/v2/auth-int
#MARKETPLACE_SYNC_INTERVAL=60

# Set to 1 to see the generated manifests without applying them.
#DRY_RUN=1
